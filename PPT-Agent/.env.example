# PPT-Agent 环境变量示例
# 复制为 .env 后填写。本文件由 load_env_files() 自动读取（无论从哪个目录运行，
# 都会优先查找 agent.py 同级的 .env）。

# ══════════════════════════════════════════════════════════
# 一、模型凭据（必填其一）
# ══════════════════════════════════════════════════════════
# 只填一家即可。agent 会按顺序自动探测；同时填多家时请用 PPT_AGENT_PROVIDER 明确指定。

# —— DeepSeek（key 形如 sk- + 32 位十六进制，长度 35）——
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# —— OpenRouter（key 必须以 sk-or- 开头，约 73 字符）——
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# —— 其他内置提供商 ——
# MOONSHOT_API_KEY=          # api.moonshot.cn      默认 kimi-k2-0905-preview
# DASHSCOPE_API_KEY=         # 阿里通义              默认 qwen-max
# ZHIPUAI_API_KEY=           # 智谱                  默认 glm-4.6
# SILICONFLOW_API_KEY=       # 硅基流动              默认 deepseek-ai/DeepSeek-V3
# OPENAI_API_KEY=            # api.openai.com        默认 gpt-4o

# ══════════════════════════════════════════════════════════
# 二、提供商选择（可选）
# ══════════════════════════════════════════════════════════
# 显式指定，避免同名 key 环境变量互相干扰。
# 可选值：openrouter | deepseek | openai | moonshot | dashscope | zhipu | siliconflow
PPT_AGENT_PROVIDER=deepseek

# 自定义 OpenAI 兼容端点（代理 / 私有网关）。设了它就会覆盖上述默认地址。
# PPT_AGENT_BASE_URL=https://your-gateway.example.com/v1

# 覆盖默认模型名（不填则用该提供商的默认模型）
# PPT_AGENT_MODEL=deepseek-chat

# ══════════════════════════════════════════════════════════
# 三、路径与运行参数（可选）
# ══════════════════════════════════════════════════════════
# ppt-master skill 根目录；不填则自动探测
# PPT_MASTER_SKILL_DIR=C:/ClaudeWorkPlace/自建Agent/ppt-master/skills/ppt-master

# 生成项目的落盘根目录；不填则用 <SKILL_DIR>/projects
# PPT_AGENT_OUTPUT_ROOT=C:/ClaudeWorkPlace/自建Agent/PPT-Agent/output

# ══════════════════════════════════════════════════════════
# 四、skill 自身的图片能力凭据（可选）
# ══════════════════════════════════════════════════════════
# 未配置时 skill 按 no-AI replan 规则降级为原生图形，不会中断流程。
# 完整清单见 <SKILL_DIR>/.env.example
# PEXELS_API_KEY=
# UNSPLASH_ACCESS_KEY=

# ── 配图（P2.6 取图阶段，可选）──────────────────────────
# 只有显式传 --image-source web|ai|auto 才会用到；默认 off，行为完全不变。
# 图库：Openverse / Wikimedia 免密钥（公开版权素材多，红楼梦古画就在 Wikimedia）；
#       Pexels / Pixabay 需免费 key，实景/产品图更稳。
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
#
# AI 生图：人物/国风/概念插画更适合走这条。
# 网络实测（2026-10-18）：dashscope / 智谱 / 火山 / 硅基流动 可达；openai / gemini 不可达。
# IMAGE_BACKEND=qwen
# QWEN_API_KEY=
# IMAGE_BACKEND=zhipu
# ZHIPU_API_KEY=
#
# 体检命令（不花钱，只测连通性和凭据）：
#   python check_image_sources.py

# 取图代理（可选）。只作用于取图子进程，不会把 DeepSeek 主链绕进代理。
# 实测（2026-10-18）：本机 127.0.0.1:7897 可稳定访达 Wikimedia；
# 直连是时段性不稳定（同一主机时会时而超时）。
# PPT_IMAGE_PROXY=http://127.0.0.1:7897
